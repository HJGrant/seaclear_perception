<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oakd_isaac_ros</name>
  <version>0.0.1</version>
  <description>Run Isaac ROS with OAK-D PoE.</description>
  <maintainer email="hamish.grant@tum.de">itr</maintainer>
  <license>Apache License 2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_python</exec_depend>
  
  
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>OpenCV</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>foxglove_msgs</depend>
  <depend>isaac_ros_gxf</depend>
  <depend>isaac_ros_managed_nitros</depend>
  <depend>isaac_ros_nitros_image_type</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>sc2_visual_servo_interfaces</exec_depend>
  <exec_depend>sc2_visual_servo_perception</exec_depend>
  <exec_depend>sc2_visual_servo_controller</exec_depend>
  <exec_depend>state_estimation</exec_depend>
  <exec_depend>marine_acoustic_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
