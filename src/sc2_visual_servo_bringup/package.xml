<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sc2_visual_servo_bringup</name>
  <version>0.1.0</version>
  <description>Launch and integration tests for SeaClear2 visual servo MVP.</description>
  <maintainer email="noreply@seaclear2.local">SeaClear2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sc2_visual_servo_interfaces</depend>
  <depend>sc2_visual_servo_perception</depend>
  <depend>sc2_visual_servo_controller</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
