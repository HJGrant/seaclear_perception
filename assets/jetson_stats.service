#run sudo systemctl daemon-reload
#then sudo systemctl start jetson_stats.service
#to enable the service at boot run 
#sudo systemctl enable jetson_stats.service

[Unit]
Description=Run jetson_stats Container
After=docker.service
Requires=docker.service

[Service]
TimeoutStartSec=30
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker stop jetson_stats_container
ExecStartPre=-/usr/bin/docker rm jetson_stats_container
ExecStart=/usr/bin/docker run --name jetson_stats_container --runtime=nvidia --network host --privileged --ipc=host -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all -v /usr/bin/tegrastats:/usr/bin/tegrastats -v /usr/lib/aarch64-linux-gnu/tegra:/usr/lib/aarch64-linux-gnu/tegra -v /usr/src/jetson_multimedia_api:/usr/src/jetson_multimedia_api -v /usr/share/vpi3:/usr/share/vpi3 -v /run/jtop.sock:/run/jtop.sock:ro -v /etc/localtime:/etc/localtime:ro -v /mnt/orin_ssd/workspaces/oakd_isaac_ros:/workspaces/oakd_isaac_ros/ --entrypoint /workspaces/oakd_isaac_ros/my_ws/my_docker/jetson_stats_entrypoint.sh hjgrant99/nvblox_dynamics_oakd_jetson_aarch64:latest
ExecStop=-/usr/bin/docker stop jetson_stats_container
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jetson_stats

[Install]
WantedBy=multi-user.target


