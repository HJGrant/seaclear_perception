ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

# The isaac_ros_common base layers this image is built on (ros2_humble.oakd
# image key) sometimes come through with sudo's shipped files (/etc/sudo.conf,
# /usr/libexec/sudo/sudoers.so, etc.) owned by uid 1000 instead of root, which
# breaks every "sudo" call downstream (including the luxonis
# install_dependencies.sh script used below). Reinstalling restores correct
# ownership on everything the package ships, rather than chasing files one at
# a time.
RUN apt-get update && apt-get install --reinstall -y sudo && rm -rf /var/lib/apt/lists/*

# Locate the failing RUN block:
# RUN sed -i '/isaac\.download\.nvidia\.com/s/^deb /deb [check-valid-until=no] /' /etc/apt/sources.list.d/* && \
#     apt update && apt-get upgrade -y

# Replace it with the following:
RUN rm -rf /var/lib/apt/lists/* && \
    sed -i '/isaac\.download\.nvidia\.com/s/^deb /deb [check-valid-until=no] /' /etc/apt/sources.list.d/* || true && \
    apt update && apt-get upgrade -y
#Install extra ROS packages for Isaac Perceptor
#RUN apt update && apt-get upgrade -y

RUN apt-get update && \
    #apt-get install -y ros-humble-isaac-ros-visual-slam && \
    apt-get install -y \
    ros-humble-isaac-ros-nvblox \
    ros-humble-isaac-ros-jetson-stats && \
    rosdep update && \
    rosdep install isaac_ros_nvblox \
    && rm -rf /var/lib/apt/lists/*

# realsense_splitter (now vendored directly under src/isaac_ros_nvblox/nvblox_examples
# instead of pulled in as a submodule) depends on realsense2_camera_msgs, which isn't
# part of ros-humble-isaac-ros-nvblox above and isn't vendored in src/ either.
RUN apt-get update && \
    apt-get install -y ros-humble-realsense2-camera-msgs \
    && rm -rf /var/lib/apt/lists/*

#Install depthai ros package for the OAK-D ROS driver
RUN rm -f /etc/apt/sources.list.d/yarn.list && \
    apt-get update --allow-releaseinfo-change && \
    wget -qO- https://docs.luxonis.com/install_dependencies.sh | bash && \
    python3 -m pip install -U depthai && \
    apt-get install -y ros-humble-depthai-ros && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y \
    ros-humble-sensor-msgs \
    ros-humble-std-msgs \
    ros-humble-geometry-msgs \
    ros-humble-nav-msgs \
    ros-humble-cv-bridge \
    ros-humble-foxglove-msgs \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libjson-glib-dev \
    libsoup2.4-dev \
    gstreamer1.0-nice \
    libnice10 \
    dbus \
    avahi-daemon \
    libnss-mdns \
    python-is-python3 \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-plugins-rtp \
    gstreamer1.0-x \
    gstreamer1.0-gl \
    python3-gst-1.0 \
    libgstrtspserver-1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-tools \
    gstreamer1.0-alsa \
    gstreamer1.0-gtk3 \
    gstreamer1.0-qt5 \
    gstreamer1.0-pulseaudio \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ninja-build \
    libboost-all-dev \
    openssl \
    libcurl4-openssl-dev \
    libssl-dev \
    libgtk-3-dev \
    libglib2.0-dev \
    pulseaudio \
    libasound2-dev \
    libpulse-dev \
    libjpeg-turbo8 \
    libjpeg-turbo8-dev

WORKDIR /home/3rdparty/jsoncpp/
RUN git clone https://github.com/open-source-parsers/jsoncpp.git . && \
    mkdir build && \
    cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC_LIBS=ON -DBUILD_SHARED_LIBS=OFF -DARCHIVE_INSTALL_DIR=. -G "Unix Makefiles" .. &&  \
    make && \
    make install
ENV LD_LIBRARY_PATH=/usr/local/lib/:$LD_LIBRARY_PATH

# Start dbus and avahi-daemon automatically on container start (no systemd)
# Note: source path is relative to this Dockerfile's folder (my_ws/my_docker)
COPY entrypoint_additions/10-dbus-avahi.sh /usr/local/bin/scripts/entrypoint_additions/10-dbus-avahi.sh
RUN chmod +x /usr/local/bin/scripts/entrypoint_additions/10-dbus-avahi.sh || true

# ---- Dev convenience: auto-wire jetson-inference env at runtime ----
# Point to expected local install under the bind-mounted workspace (harmless if missing)
ENV JI_PREFIX=/workspaces/oakd_isaac_ros/my_ws/3rdparty/jetson-inference/install
ENV CMAKE_PREFIX_PATH=${JI_PREFIX}${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH} \
    LD_LIBRARY_PATH=${JI_PREFIX}/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} \
    LIBRARY_PATH=${JI_PREFIX}/lib${LIBRARY_PATH:+:$LIBRARY_PATH} \
    CPATH=${JI_PREFIX}/include${CPATH:+:$CPATH} \
    PYTHONPATH=${JI_PREFIX}/python${PYTHONPATH:+:$PYTHONPATH}

# Auto-source the workspace env script on interactive shells if present
RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'JI_SRC=/workspaces/oakd_isaac_ros/my_ws/scripts/source_jetson_inference.sh' \
    '[ -f "$JI_SRC" ] && source "$JI_SRC" || true' \
    > /etc/profile.d/jetson_inference.sh \
    && chmod +x /etc/profile.d/jetson_inference.sh \
    && printf '\n# Auto-source jetson-inference env if available\n[ -f /workspaces/oakd_isaac_ros/my_ws/scripts/source_jetson_inference.sh ] && source /workspaces/oakd_isaac_ros/my_ws/scripts/source_jetson_inference.sh\n' >> /etc/bash.bashrc

RUN pip3 install -U jetson-stats

RUN apt-get update --allow-releaseinfo-change -y && apt install -y \
    ros-humble-marine-acoustic-msgs \
    ros-humble-isaac-ros-ess \
    ros-humble-isaac-ros-ess-models-install \
    ros-humble-isaac-ros-h264-encoder \
    ros-humble-isaac-ros-h264-decoder \
    && rm -rf /var/lib/apt/lists/*

# Native/runtime deps for the vendored src/isaac_ros_dnn_inference and
# src/isaac_ros_object_detection packages (tensor_rt, triton, dnn_image_encoder,
# detectnet) -- these ROS packages build from local source, but need Triton's
# client libraries etc. that only the .deb ships, not the git checkout.
RUN apt-get update --allow-releaseinfo-change -y && apt install -y \
    ros-humble-isaac-ros-tensor-rt \
    ros-humble-isaac-ros-triton \
    ros-humble-isaac-ros-dnn-image-encoder \
    ros-humble-isaac-ros-detectnet \
    ros-humble-robot-localization \
    && rm -rf /var/lib/apt/lists/*

# ---- jetson-utils / jetson-inference (needed by ros_deep_learning for RTP
# video_output) built into the image, matching the jsoncpp pattern above.
# Skips the pose (trt_pose) and camera-capture submodules and the Python
# bindings -- none of it is needed for ros_deep_learning's video_output, and
# skipping it avoids pulling in extra heavy deps (e.g. libtorch for trt_pose).
WORKDIR /opt/jetson-inference
RUN git clone --recurse-submodules https://github.com/dusty-nv/jetson-inference . && \
    sed -i \
      -e '/file(GLOB inferenceSources/a list(REMOVE_ITEM inferenceSources ${CMAKE_CURRENT_SOURCE_DIR}/c/poseNet.cpp)' \
      -e '/file(GLOB inferenceIncludes/a list(REMOVE_ITEM inferenceIncludes ${CMAKE_CURRENT_SOURCE_DIR}/c/poseNet.h)' \
      -e 's|add_subdirectory(python)|#add_subdirectory(python)  # not needed for ros_deep_learning; would hit PyPoseNet.cpp|' \
      -e 's|add_subdirectory(examples)|#add_subdirectory(examples)  # demo CLIs unused by ros_deep_learning; imagenet/segnet/depthnet fail to link against libcudla.so.1 since the Docker build has no L4T DLA libs (docker build does not pass through /usr/lib/aarch64-linux-gnu/nvidia)|' \
      CMakeLists.txt && \
    sed -i 's|add_subdirectory(posenet)|#add_subdirectory(posenet)  # links poseNet, excluded above|' examples/CMakeLists.txt && \
    sed -i 's|add_subdirectory(camera-capture)|#add_subdirectory(camera-capture)  # GUI tool, unused for video streaming|' tools/CMakeLists.txt && \
    sed -i \
      's|target_link_libraries(${target} ${CUDA_LINK_LIBRARIES_KEYWORD} ${CUDA_cublas_LIBRARY} ${CUDA_cublas_device_LIBRARY})|if (CUDA_cublas_device_LIBRARY)\n      target_link_libraries(${target} ${CUDA_LINK_LIBRARIES_KEYWORD} ${CUDA_cublas_LIBRARY} ${CUDA_cublas_device_LIBRARY})\n    else()\n      target_link_libraries(${target} ${CUDA_LINK_LIBRARIES_KEYWORD} ${CUDA_cublas_LIBRARY})\n    endif()|' \
      utils/cuda/FindCUDA.cmake && \
    mkdir build && cd build && \
    cmake -DBUILD_TESTING=OFF -DBUILD_INTERACTIVE=NO ../ && \
    make -j$(nproc) && \
    make install && \
    ldconfig
WORKDIR /

# temporary fix while the foxglove-bridge is not available in the standard apt repository
RUN apt-get update \
    && apt install -y ros2-testing-apt-source \
    && apt update \
    && apt install -y ros-$ROS_DISTRO-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

# After your ROS installation steps
RUN apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-mavros-msgs \
    && rm -rf /var/lib/apt/lists/*

#RUN pip install "numpy<2"

# Git settings for building the bind-mounted workspace inside the container.
# - setuptools-scm runs `git archive` during every Python egg step, which makes
#   git-lfs SSH to gitlab.lrz.de (no key in here -> host-key prompts / failed
#   builds). LFS files are already checked out by the host, so disable the
#   smudge/download side here. (Must be config files: setuptools-scm strips
#   GIT_* env vars before calling git.)
# - The workspace is owned by the host user, so git refuses it when building
#   as root ("dubious ownership") unless it's marked safe.
RUN git config --system filter.lfs.process "" && \
    git config --system filter.lfs.smudge cat && \
    git config --system filter.lfs.required false && \
    git config --system --add safe.directory '*'
