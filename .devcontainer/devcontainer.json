{
  "name": "My OAK-D Dev",
  "image": "isaac_ros_dev-x86_64",
  "runArgs": [
    "--gpus", "all", 
    "--network", "host", 
    "--cpus", "16.0",  
    "--memory", "32g",
    "--volume=${localEnv:HOME}/workspaces/oakd_isaac_ros:/oakd_isaac_ros",
    "--volume=${localEnv:HOME}/.ros/fastdds.xml:/root/.ros/fastdds.xml"
  ],

  "postCreateCommand": "echo 'Dev container is ready!'",

  "containerUser": "root",
  "workspaceFolder": "/oakd_isaac_ros",


  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "twxs.cmake"
      ]
    }
  }
}
