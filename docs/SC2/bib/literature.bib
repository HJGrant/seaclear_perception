@article{yuan-sheng_yu_autonomous_2022,
	title = {An autonomous collision avoidance system unified with the {TFMS} and the {FCS}-{MPC} strategy for {USV}},
	doi = {10.23919/ccc55666.2022.9902408},
	abstract = {In order to realize the autonomous collision avoidance of unmanned surface vehicle({USV}), a collision avoidance system({CAS}) for {USV} based on the Tunable Fast Marching Square method({TFMS}) and the Finite Control Set-Model Predictive Control ({FCS}-{MPC}) strategy is proposed. First, the navigation simulation model of the {USV} is established. Then, the {TFMS} is adopted to get the optimal path from start point to destination point in given environment. {FCS}-{MPC} is used under the constraints of local environment and dynamic model of {USV} to ensure collision avoidance during navigation. Finally, the track point in the global planned path is served as the local target points of collision avoidance strategy, so the {USV} can arrive at the final target points safely and independently. Simulation experiments are carried out with real coastal map as environmental constraints to validate the effectiveness of proposed {CAS}.},
	journaltitle = {Cybersecurity and Cyberforensics Conference},
	author = {{Yuan-Sheng Yu} and {Yunsheng Fan} and {Yun Zhang} and {Dongdong Mu} and {Xiaojie Sun}},
	date = {2022},
	doi = {10.23919/ccc55666.2022.9902408},
	note = {S2ID: fa9742a6f6494b27ca0c7e510c2410dbfb1a9fa8},
	keywords = {mpc},
}

@article{bei_hu_collision_2022,
	title = {Collision avoidance of {USV} by model predictive control-aided deep reinforcement learning},
	doi = {10.1109/icit48603.2022.10002769},
	abstract = {This paper proposes a model predictive control ({MPC})-aided deep reinforcement learning ({DRL}) algorithm to address the collision avoidance problem of unmanned surface vessel ({USV}). By combining with {MPC}, the complexity of the learning model will decrease, and the obstacle avoidance path will be safer. In this control and learning synthesized algorithm, the {DRL} network learns and generates velocity, and the {MPC} controller adjusts {USV} to navigate by tracking this velocity. The simulation indicated that the proposed algorithm could successfully avoid obstacles with steady and safe status.},
