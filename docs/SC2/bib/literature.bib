@article{souissi_path_nodate,
	title = {Path planning: A 2013 survey},
	abstract = {In the recent decades an impressive progress was done in automation and robotic ﬁelds. Projects such as Google driverless car with “sense and avoid” capabilities or intelligent Unmanned Air Vehicle ({UAV}) are examples of interesting research works targeting a high degree of autonomy. In this context we underline the unavoidable requirement for improving path planning algorithms. Indeed, path planning is one of the essential tasks in the automation process of a system that moves in the environment while avoiding obstacles and respecting various constraints. In this paper we present a state-of-the-art of path planning in the ﬁeld of automation, robotics and video games. Furthermore, we focus on widespread algorithms that can satisfy real-time constraints and dynamic re-planning.},
	author = {Souissi, Omar and Benatitallah, Rabie and Duvivier, David and Artiba, {AbedlHakim} and Belanger, Nicolas and Feyzeau, Pierre},
	langid = {english},
